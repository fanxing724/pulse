[Unit]
Description=Pulse website monitoring
After=network-online.target
Wants=network-online.target

[Service]
User=pulse
Group=pulse
WorkingDirectory=/home/fanxing/services/pulse
ExecStart=/usr/bin/python3 /home/fanxing/services/pulse/server.py
Environment=PULSE_CONFIG=/etc/pulse/config.json
Environment=PULSE_STATE=/var/lib/pulse
Environment=PULSE_PORT=80
Environment=PULSE_BIND=::
Environment=PULSE_TLS_PORT=443
Environment=PULSE_CERT=/etc/pulse/tls.crt
Environment=PULSE_KEY=/etc/pulse/tls.key
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
StateDirectory=pulse
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
MemoryHigh=96M
MemoryMax=128M
CPUQuota=40%
TasksMax=48
LimitNOFILE=512
LogRateLimitIntervalSec=30s
LogRateLimitBurst=40

[Install]
WantedBy=multi-user.target
